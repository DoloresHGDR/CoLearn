# Clave de OpenRouter (generación de actividades, evaluación, pistas y resumen del docente)
OPENROUTER_API_KEY=tu_clave_aqui

# Modelo de lenguaje que se usa a través de OpenRouter
OPENROUTER_MODEL=openai/gpt-4o-mini

# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/colearn

# Carpeta base para uploads y caché de embeddings
DATA_DIR=./data

# Clave secreta para firmar los tokens JWT
SECRET_KEY=cambiar-en-produccion

# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sufijo del correo institucional que se exige en el registro
INSTITUTIONAL_EMAIL_SUFFIX=.edu.ar
